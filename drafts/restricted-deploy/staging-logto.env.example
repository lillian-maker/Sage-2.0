# G1 Logto staging environment example.
# Copy to /etc/sage/logto/staging-logto.env, mode 0400, never commit the filled file.
# The same file is used for Compose interpolation and as the Logto container env_file.
# Replace every <...> placeholder before starting the stack.

# Pinned image digest. Never use `latest`.
# Docker Hub official image, same digest as GHCR. GHCR pull may stall in mainland networks.
LOGTO_IMAGE=svhd/logto@sha256:<pin>

# Public endpoint terminates TLS at the host nginx; Logto appends /oidc.
LOGTO_ENDPOINT=https://auth.staging.sagegogo.com
LOGTO_ADMIN_ENDPOINT=http://127.0.0.1:3102

# Loopback ports. The admin port is for an SSH tunnel only.
LOGTO_HTTP_PORT=3101
LOGTO_ADMIN_PORT=3102

# Paths on the staging host.
LOGTO_ENV_FILE=/etc/sage/logto/staging-logto.env
LOGTO_SECRETS_DIR=/etc/sage/logto/secrets

# Logto container environment.
# DB_URL must match the database credential in $LOGTO_SECRETS_DIR/logto_db_pass.
# Use a hex-encoded credential (openssl rand -hex 24) so the URL needs no escaping.
DB_URL=postgres://logto:<db-credential>@logto-db:5432/logto
# 32 random bytes, base64 (openssl rand -base64 32).
SECRET_VAULT_KEK=<base64-32-bytes>
